generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @default("User")
  xp        Int      @default(0)
  level     Int      @default(1)
  rank      String   @default("E")
  stats     Json     @default("{}")
  pushSub   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks        Task[]
  fitnessLogs  FitnessLog[]
  transactions Transaction[]
  links        Link[]
  deadlines    Deadline[]
  jobs         Job[]
  projects     Project[]
  notes        Note[]
  cyberLabs    CyberLab[]

  @@index([email])
}

model Task {
  id        String    @id @default(uuid())
  title     String
  priority  String    @default("Medium") // Low | Medium | High | Critical
  category  String    @default("Work")   // Work | Personal | Health | Finance | Learning
  deadline  DateTime?
  done      Boolean   @default(false)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([done])
}

model FitnessLog {
  id          String   @id @default(uuid())
  date        DateTime @default(now())
  weight      Float
  calories    Int      @default(0)
  protein     Int      @default(0)
  water       Float    @default(0)
  workoutDone Boolean  @default(false)
  notes       String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
}

model Transaction {
  id          String   @id @default(uuid())
  amount      Float
  type        String   // income | expense | subscription | investment
  category    String
  description String?
  isNecessary Boolean  @default(true)
  date        DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([type])
  @@index([date])
  @@index([category])
}

model Link {
  id           String   @id @default(uuid())
  url          String
  title        String
  description  String?
  category     String   @default("General")
  isBookmarked Boolean  @default(false)
  usefulScore  Int      @default(3) // 1-5
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@index([isBookmarked])
}

model Deadline {
  id         String   @id @default(uuid())
  title      String
  date       DateTime
  priority   String   @default("Medium")
  category   String   @default("General")
  recurring  Boolean  @default(false)
  notified   Boolean  @default(false)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([date])
}

model Job {
  id            String   @id @default(uuid())
  company       String
  role          String
  stage         String   @default("applied") // applied | screening | interview | offer | rejected
  salary        String?
  url           String?
  resumeUsed    String?
  notes         String?
  rejectionNote String?
  appliedDate   DateTime @default(now())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([stage])
}

model Project {
  id                   String   @id @default(uuid())
  title                String
  stack                String?
  status               String   @default("planning") // planning | active | paused | completed | abandoned
  completionPercentage Int      @default(0)
  githubUrl            String?
  deploymentUrl        String?
  lessons              String?
  blockers             String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Note {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String   @default("General")
  tags      String[] @default([])
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([category])
}

model CyberLab {
  id          String   @id @default(uuid())
  platform    String   // HackTheBox | TryHackMe | PortSwigger | Other
  name        String
  difficulty  String   // Easy | Medium | Hard | Insane
  notes       String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@index([userId])
  @@index([platform])
}
